$PROBLEM  easy-nonmem example — 1-cpt IV, 1 subject
$INPUT  ID TIME AMT DV EVID CMT MDV
$DATA   data.csv IGNORE=@

$SUBROUTINES ADVAN1 TRANS2

$PK
  TVCL = THETA(1)
  TVV  = THETA(2)
  CL   = TVCL * EXP(ETA(1))
  V    = TVV
  S1   = V

$ERROR
  IPRED = F
  Y     = IPRED * (1 + EPS(1)) + EPS(2)

$THETA
  (0, 2, 50)   ; CL
  (0, 20, 200) ; V

$OMEGA
  1.E-30 FIX ; negligible IIV for quick self-test

$SIGMA
  0.05 0.0001

$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999 SIGDIG=3 PRINT=5 POSTHOC
$COVARIANCE PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES MDV EVID NOAPPEND NOPRINT FILE=sdtab1 ONEHEADER
$TABLE ID ETA1 NOAPPEND NOPRINT FILE=patab1 ONEHEADER
