<DATAFILE>

[FILEINFO]
file={path='../../../theophylline_data.csv'}
delimiter = comma
header={ID, AMT, TIME, CONC, WEIGHT, SEX}

[CONTENT]
ID = {use=identifier}
AMT = {use=amount}
TIME = {use=time}
CONC = {use=observation, type=continuous}
WEIGHT = {use=covariate, type=continuous}
SEX = {use=covariate, type=categorical}

<MODEL>

[COVARIATE]
input = {WEIGHT, SEX}

SEX = {type=categorical, categories={'F', 'M'}}

EQUATION:
logtWEIGHT = log(WEIGHT/70)

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, WEIGHT, beta_V_WEIGHT, beta_ka_WEIGHT}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, covariate=WEIGHT, coefficient=beta_ka_WEIGHT, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, covariate=WEIGHT, coefficient=beta_V_WEIGHT, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}

[LONGITUDINAL]
input = {a, b}

file = 'lib:oral1_1cpt_kaVCl.txt'

DEFINITION:
CONC = {distribution=normal, prediction=Cc, errorModel=combined1(a, b)}

<FIT>
data = 'CONC'
model = CONC

<PARAMETER>
Cl_pop = {value=0.1, method=MLE}
V_pop = {value=0.5, method=MLE}
a = {value=1, method=MLE}
b = {value=0.3, method=MLE}
beta_V_WEIGHT = {value=0, method=MLE}
beta_ka_WEIGHT = {value=0, method=MLE}
c = {value=1, method=FIXED}
ka_pop = {value=1, method=MLE}
omega_Cl = {value=1, method=MLE}
omega_V = {value=1, method=MLE}
omega_ka = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(run = false,method = Linearization)
logLikelihood(method = Linearization)

[PLOTS]
run = false
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'ModelBuilding_004'

